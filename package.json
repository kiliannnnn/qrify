{
  "name": "@kiliannnnn/qrify",
  "version": "2.0.0",
  "description": "QR code generator for the web: a zero-dependency UTF-8 encoder, an SSR-friendly SVG renderer, and a <qr-code> custom element.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "default": "./core.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./index.js"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "core.js",
    "core.d.ts",
    "src/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:core": "node --test test/*.test.js",
    "test:dom": "node --test test/dom/*.test.js",
    "test": "npm run test:core && npm run test:dom",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiliannnnn/qrify.git"
  },
  "keywords": [
    "qr-code",
    "qrcode",
    "generator",
    "svg",
    "canvas",
    "astro",
    "ssr",
    "html",
    "component",
    "web-component",
    "custom-element",
    "qrify",
    "qr"
  ],
  "author": "kiliannnnn",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/kiliannnnn/qrify/issues"
  },
  "homepage": "https://github.com/kiliannnnn/qrify#readme",
  "devDependencies": {
    "@zxing/library": "^0.21.3",
    "jsdom": "^30.0.1",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.7.2"
  }
}
